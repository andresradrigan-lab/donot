// =============================================================
// donot-platform — Prisma schema (MariaDB / MySQL)
// Documentación completa: docs/SPEC.md sección 5
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // CloudLinux de Hostinger usa OpenSSL 1.1 con glibc; el runner de
  // GitHub Actions es Ubuntu 24.04 con OpenSSL 3.0. Sumamos varios
  // targets para que el binario correcto esté disponible donde sea
  // que se ejecute. Necesario aunque usemos el adapter mariadb,
  // porque algunas operaciones del cliente (parser, schema reflection)
  // usan el binary engine.
  binaryTargets = ["native", "rhel-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum BoxCategory {
  PREMIUM
  AZUCARADA
  MIX
  COLAB
}

enum FlavorCategory {
  PREMIUM
  AZUCARADA
}

enum DeliveryMethod {
  PICKUP_CONCON
  PICKUP_RENACA
  DELIVERY
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MERCADO_PAGO
  TRANSBANK
  KHIPU
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum AdminRole {
  OWNER
  OPERATOR
  VIEWER
}

enum WebhookProvider {
  MERCADO_PAGO
  TRANSBANK
  KHIPU
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

// ===== MODELOS =====

/// Colección limitada de sabores (Droop 001, Droop 002...)
model Droop {
  id            String   @id @default(uuid())
  code          String   @unique // "droop_001"
  name          String
  tagline       String?
  description   String?  @db.Text
  coverImage    String?
  startsAt      DateTime
  endsAt        DateTime?
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  flavors       Flavor[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([isPublished, startsAt, endsAt])
}

/// Caja (producto principal). El usuario configura sabores dentro.
/// availableWeekdays se guarda como JSON (array de ints 0..6, dom..sab),
/// porque MySQL/MariaDB no soporta arrays nativos. El filtrado por día
/// actual se hace en memoria en lib/catalog.ts.
model Box {
  id                   String      @id @default(uuid())
  slug                 String      @unique
  name                 String
  category             BoxCategory
  slotCount            Int
  priceClp             Int
  images               Json        // string[] de URLs
  isActive             Boolean     @default(true)
  availableWeekdays    Json        // number[] (0=dom..6=sab)
  availableFrom        DateTime?
  availableTo          DateTime?
  sortOrder            Int         @default(0)
  orderItems           OrderItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  @@index([isActive, sortOrder])
}

/// Sabor individual (sub-producto). Pertenece a un Droop opcional.
model Flavor {
  id                String          @id @default(uuid())
  slug              String          @unique
  name              String
  category          FlavorCategory
  description       String          @db.Text
  imageUrl          String          @db.Text
  droopId           String?
  droop             Droop?          @relation(fields: [droopId], references: [id])
  stock             Int             @default(0)
  stockResetDaily   Boolean         @default(false)
  dailyCapacity     Int?
  isActive          Boolean         @default(true)
  availableWeekdays Json            // number[] (0=dom..6=sab)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([isActive, droopId])
  @@index([category])
}

/// Pedido del cliente.
model Order {
  id                  String          @id @default(uuid())
  orderNumber         String          @unique
  customerEmail       String
  customerName        String
  customerPhone       String

  deliveryMethod      DeliveryMethod
  deliveryAddress     String?         @db.Text
  deliveryCommune     String?
  deliveryNotes       String?         @db.Text
  deliveryDate        DateTime?
  deliveryTimeSlot    String?

  subtotalClp         Int
  discountClp         Int             @default(0)
  shippingClp         Int             @default(0)
  totalClp            Int
  couponCode          String?
  coupon              Coupon?         @relation(fields: [couponCode], references: [code])

  status              OrderStatus     @default(PENDING)
  paymentProvider     PaymentProvider
  paymentId           String?
  paymentStatus       PaymentStatus   @default(PENDING)

  publicToken         String          @unique

  paidAt              DateTime?
  preparingAt         DateTime?
  inTransitAt         DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?

  items               OrderItem[]
  webhookLogs         WebhookLog[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([paymentId])
  @@index([deliveryDate])
  @@index([couponCode])
}

/// Línea de pedido — una caja con sus sabores.
model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  boxId             String
  box               Box      @relation(fields: [boxId], references: [id])
  boxNameSnapshot   String
  boxPriceSnapshot  Int
  flavors           Json     // [{ flavorSlug, flavorName, qty }]
  quantity          Int      @default(1)
  lineTotalClp      Int

  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([boxId])
}

/// Cupón de descuento.
model Coupon {
  id                  String     @id @default(uuid())
  code                String     @unique
  type                CouponType
  value               Int
  minOrderClp         Int?
  maxUses             Int?
  usesCount           Int        @default(0)
  maxUsesPerUser      Int?
  validFrom           DateTime
  validTo             DateTime?
  isActive            Boolean    @default(true)
  orders              Order[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([code, isActive])
}

/// Zona de despacho (comuna con tarifa).
model CoverageZone {
  id                          String   @id @default(uuid())
  commune                     String
  region                      String
  shippingClp                 Int
  freeShippingThresholdClp    Int?
  freeShippingMinBoxes        Int?
  isActive                    Boolean  @default(true)
  sortOrder                   Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([commune, region])
  @@index([isActive])
}

/// Usuario administrativo.
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

/// Auditoría de webhooks de pasarelas (idempotencia + debugging).
/// MySQL/MariaDB tratan múltiples NULL como distintos en unique indexes,
/// así que el unique compuesto sigue funcionando aun con externalId null.
model WebhookLog {
  id            String          @id @default(uuid())
  provider      WebhookProvider
  eventType     String
  externalId    String?
  payload       Json
  headers       Json
  status        WebhookStatus   @default(RECEIVED)
  errorMessage  String?         @db.Text
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id])
  receivedAt    DateTime        @default(now())
  processedAt   DateTime?

  @@unique([provider, externalId])
  @@index([provider, status])
  @@index([orderId])
}

/// Configuración global del sitio (key-value).
model SiteSetting {
  key         String   @id @db.VarChar(80)
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

/// Imagen de la galería pública. Sin pagination en MVP — orden manual.
model GalleryImage {
  id          String    @id @default(uuid())
  imageUrl    String    @db.Text
  caption     String?
  alt         String?
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isPublished, sortOrder])
  @@index([deletedAt])
}

/// Post del blog. Markdown en `content`. SEO override opcional;
/// si los campos seo* quedan vacíos, las páginas usan title/excerpt/coverImage.
model BlogPost {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  excerpt        String    @db.Text
  content        String    @db.LongText
  coverImage     String?   @db.Text
  author         String    @default("donot.")
  tags           Json      // string[]

  seoTitle       String?
  seoDescription String?   @db.Text
  ogImage        String?   @db.Text

  isPublished    Boolean   @default(false)
  publishedAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([isPublished, publishedAt])
  @@index([deletedAt])
}
