# =============================================================
# Variables de entorno de PRODUCCIÓN
# Pega este archivo en el VPS como:
#   /var/www/donot-platform/shared/.env.production
#
# Permisos:
#   sudo chown donot:donot /var/www/donot-platform/shared/.env.production
#   sudo chmod 600         /var/www/donot-platform/shared/.env.production
#
# IMPORTANTE: este archivo NO se versiona. release.sh lo enlaza a la
# release activa con un symlink.
# =============================================================

# --- App ---
APP_URL=https://donot.cl
NODE_ENV=production

# --- Base de datos ---
# Reemplaza por la contraseña que imprimió provision-vps.sh.
DATABASE_URL=postgresql://donot:CAMBIAR_POR_LA_PASS@localhost:5432/donot_prod?schema=public

# --- Auth admin ---
# Genera con: openssl rand -base64 32
JWT_SECRET=GENERAR_CON_OPENSSL_RAND_BASE64_32

ADMIN_INITIAL_EMAIL=andres@morgansmedia.cl
# Solo se usa la primera vez en `prisma db seed`. Después se cambia desde /admin/usuarios.
ADMIN_INITIAL_PASSWORD=CAMBIAR_EN_PRIMER_LOGIN

# --- Mercado Pago (PRODUCCIÓN, no sandbox) ---
# Sacar del panel de MP del cliente, no las de sandbox.
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
# Activar firma del webhook desde el panel de MP y pegar el secret aquí.
MP_WEBHOOK_SECRET=PEGAR_EL_SECRET_DEL_PANEL_DE_MP

# --- Email transaccional (Resend) ---
# https://resend.com → verificar dominio donot.cl primero (DKIM, SPF, MX).
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hola@donot.cl
RESEND_FROM_NAME=donot.

# --- Cloudinary (opcional) ---
# Si se queda en blanco, los uploads van a public/uploads/ del VPS.
CLOUDINARY_URL=

# --- Analítica (FALLBACK opcional) ---
# Estos IDs se gestionan desde /admin/config. Las vars solo son fallback
# si la BD no tiene valor cargado todavía. Pueden quedar vacías.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# --- Configuración de negocio (defaults para el seed) ---
DEFAULT_FREE_SHIPPING_THRESHOLD_CLP=50000
DEFAULT_FREE_SHIPPING_MIN_BOXES=3
ORDER_NUMBER_PREFIX=DN
