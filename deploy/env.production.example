# =============================================================
# Variables de entorno de PRODUCCIÓN (Hostinger Cloud Hosting)
#
# Pega este archivo en el servidor como:
#   ~/donot-platform/shared/.env.production
#
# Permisos:
#   chmod 600 ~/donot-platform/shared/.env.production
#
# IMPORTANTE: este archivo NO se versiona. release.sh lo enlaza a la
# release activa con un symlink.
# =============================================================

# --- App ---
APP_URL=https://donot.cl
NODE_ENV=production
# Hostinger proxea desde el dominio a un puerto interno asignado por la
# app de Node.js que creaste en hPanel. Si elegiste 3000 al crear la app,
# déjalo en 3000.
PORT=3000
HOSTNAME=127.0.0.1

# --- Base de datos (MariaDB compartida en el mismo servidor) ---
# Reemplaza por los datos que te dio hPanel al crear la BD MySQL.
# Para apps que corren en el mismo servidor, el host correcto es
# "localhost" o "127.0.0.1". El puerto típico en Hostinger es 3306.
DATABASE_URL=mysql://u530306321_donot_app:CAMBIAR_POR_LA_PASS@localhost:3306/u530306321_donot_prod

# --- Auth admin ---
# Genera con: openssl rand -base64 32
JWT_SECRET=GENERAR_CON_OPENSSL_RAND_BASE64_32

ADMIN_INITIAL_EMAIL=andres@morgansmedia.cl
# Solo se usa la primera vez en `prisma db seed`. Después cámbialo desde /admin/usuarios.
ADMIN_INITIAL_PASSWORD=CAMBIAR_EN_PRIMER_LOGIN

# --- Mercado Pago (PRODUCCIÓN, no sandbox) ---
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
MP_WEBHOOK_SECRET=PEGAR_EL_SECRET_DEL_PANEL_DE_MP

# --- Email transaccional ---
# Si configuras SMTP se usa SMTP; si SMTP vacío y RESEND_API_KEY presente,
# se usa Resend; si ambos vacíos, los correos van a consola.

# Opción A — SMTP de Hostinger Email (recomendado para este plan)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@donot.cl
SMTP_PASS=
SMTP_FROM_EMAIL=hola@donot.cl
SMTP_FROM_NAME=donot.

# Opción B — Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@donot.cl
RESEND_FROM_NAME=donot.

# --- Cloudinary (opcional) ---
# Si queda vacío, los uploads se guardan en public/uploads/ del servidor.
CLOUDINARY_URL=

# --- Analítica (FALLBACK opcional) ---
# Estos IDs se gestionan desde /admin/config (BD). Las vars solo son
# fallback si la BD no tiene valor cargado todavía. Pueden quedar vacías.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# --- Configuración de negocio (defaults para el seed) ---
DEFAULT_FREE_SHIPPING_THRESHOLD_CLP=50000
DEFAULT_FREE_SHIPPING_MIN_BOXES=3
ORDER_NUMBER_PREFIX=DN
