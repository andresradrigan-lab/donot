# =============================================================
# donot-platform — variables de entorno
# Copia este archivo como .env y completa los valores reales.
# .env NUNCA debe commitearse.
# =============================================================

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Base de datos (Postgres local vía docker-compose) ---
DATABASE_URL=postgresql://donot:donot_dev@localhost:5432/donot_db?schema=public

# --- Auth admin ---
# Genera con: openssl rand -base64 32
JWT_SECRET=replace_me_with_random_32_bytes
# Password inicial del primer OWNER (se hashea en el seed)
ADMIN_INITIAL_EMAIL=andres@morgansmedia.cl
ADMIN_INITIAL_PASSWORD=changeme_in_first_login

# --- Mercado Pago (sandbox) ---
# https://www.mercadopago.cl/developers/panel
MP_ACCESS_TOKEN=APP_USR-PEGAR_AQUI
MP_PUBLIC_KEY=APP_USR-PEGAR_AQUI
MP_WEBHOOK_SECRET=PEGAR_AQUI

# --- Transbank Webpay Plus ---
# integration | production
TBK_ENV=integration
# En integration, los valores públicos están en docs de Transbank.
# En production, son los de la afiliación del cliente.
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# --- Khipu ---
# https://payment-api.khipu.com/v3 (modo desarrollador)
KHIPU_RECEIVER_ID=PEGAR_AQUI
KHIPU_API_KEY=PEGAR_AQUI

# --- Email transaccional (Resend) ---
# https://resend.com — verificar dominio donot.cl primero
RESEND_API_KEY=re_PEGAR_AQUI
RESEND_FROM_EMAIL=hola@donot.cl
RESEND_FROM_NAME=donot.

# --- Cloudinary (imágenes) ---
# Opcional en MVP — se puede empezar sirviendo de /public
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Analítica ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_CAPI_ACCESS_TOKEN=

# --- Configuración de negocio ---
DEFAULT_FREE_SHIPPING_THRESHOLD_CLP=50000
DEFAULT_FREE_SHIPPING_MIN_BOXES=3
ORDER_NUMBER_PREFIX=DN
